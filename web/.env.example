# Copy to .env.local for local dev. Both are optional: without them the
# view/search counters simply stay at 0 instead of erroring out.
#
# Free tier: create a Redis database at https://console.upstash.com
# (or via the Vercel Marketplace "Upstash" integration on your Vercel
# project) and paste the REST credentials it gives you below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
