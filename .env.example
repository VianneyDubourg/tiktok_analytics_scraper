# Copy this file to `.env` and adjust as needed.
# Every value is optional: config.py already has sensible defaults.

# --- Browser / timing ---
HEADLESS=false
TIMEOUT=30000
NAVIGATION_TIMEOUT=45000
VIDEO_DETAIL_TIMEOUT=20000
LOCALE=en-US
TIMEZONE_ID=UTC

# --- Manual login handoff ---
LOGIN_POLL_INTERVAL=2000
LOGIN_MAX_WAIT=600000

# --- Infinite scroll ---
SCROLL_PAUSE_MS=800
MAX_SCROLL_STAGNANT_ROUNDS=4
MAX_SCROLL_ROUNDS=2000

# --- Retries ---
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# --- URLs (only change if TikTok moves Studio to a different path) ---
BASE_URL=https://www.tiktok.com
STUDIO_PATH=/tiktokstudio
CONTENT_PATH=/content

# --- Folders ---
SESSION_FOLDER=.session
EXPORT_FOLDER=data
LOG_FOLDER=logs

# --- Export ---
TOP_RANKING_SIZE=20

# --- Logging ---
LOG_LEVEL=INFO
